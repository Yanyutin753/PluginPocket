# Complete variable reference: docs/ENVIRONMENT.md
# Kubernetes runtime-only template: deploy/kubernetes/runtime.env.example
# This file is for local source / local Compose; never reuse test credentials in production.
# Root Make development commands and pnpm dev load .env automatically.
# Standalone Go and make check still need explicitly exported variables.
PLUGINPOCKET_ADDR=127.0.0.1:8787
PLUGINPOCKET_WEB_DIR=web/dist
# Optional Vite overrides when using a different local port.
PLUGINPOCKET_DEV_PORT=5173
PLUGINPOCKET_API_ORIGIN=http://127.0.0.1:8787
# Runtime logs/socket and Vite cache. Use the same directory for up/down/status/logs;
# use a different directory for each concurrent dev/test instance.
PLUGINPOCKET_RUN_DIR=.pluginpocket
# Compose reads .env automatically; this controls the published host port.
PLUGINPOCKET_PORT=8787

# Product mode: PostgreSQL is required for accounts, wallet, tools and teams.
# Generate a URL-safe password with: openssl rand -hex 24
PLUGINPOCKET_DB_PASSWORD=
PLUGINPOCKET_DB_PORT=5432
PLUGINPOCKET_DATABASE_URL=postgres://pluginpocket:REPLACE_PASSWORD@127.0.0.1:5432/pluginpocket?sslmode=disable
# Optional shared metadata cache; Redis outages fall back to upstream discovery.
# Use the same namespace for replicas of one deployment; different deployments need distinct namespaces.
PLUGINPOCKET_REDIS_URL=redis://127.0.0.1:6379/0
PLUGINPOCKET_REDIS_NAMESPACE=pluginpocket
PLUGINPOCKET_REDIS_PORT=6379
# Tests use random namespaces and never FLUSHDB.
PLUGINPOCKET_TEST_REDIS_URL=redis://127.0.0.1:6379/0
# Optional canonical origin for public links and OAuth/email callbacks; HTTPS enables Secure cookies.
# Same-origin /api proxy requests do not require a fixed public URL.
PLUGINPOCKET_PUBLIC_URL=
# Generate once with: openssl rand -base64 32. Keep it to decrypt saved upstream credentials.
PLUGINPOCKET_ENCRYPTION_KEY=
PLUGINPOCKET_INITIAL_CREDITS=1000
# Bootstrap creates this admin only when absent; never resets an existing account.
PLUGINPOCKET_ADMIN_USERNAME=
PLUGINPOCKET_ADMIN_PASSWORD=
# Dedicated test database, schema-isolated tests; do not point at production.
PLUGINPOCKET_TEST_DATABASE_URL=postgres://pluginpocket:REPLACE_PASSWORD@127.0.0.1:5432/pluginpocket_test?sslmode=disable
# Optional integrations: remain explicitly unavailable until configured.
PLUGINPOCKET_RATE_TOKEN_PER_MINUTE=
PLUGINPOCKET_RATE_USER_PER_DAY=
PLUGINPOCKET_GITHUB_API=
PLUGINPOCKET_GITHUB_TOKEN=
PLUGINPOCKET_GITHUB_CLIENT_ID=
PLUGINPOCKET_GITHUB_CLIENT_SECRET=
PLUGINPOCKET_GITHUB_ORG=
PLUGINPOCKET_SMTP_ADDRESS=
PLUGINPOCKET_SMTP_FROM=
PLUGINPOCKET_SMTP_USERNAME=
PLUGINPOCKET_SMTP_PASSWORD=
PLUGINPOCKET_SMTP_ALLOW_LOCAL_INSECURE=false
# Deployment-controlled upstream exceptions. Default HTTPS/public networks only.
PLUGINPOCKET_ALLOW_PRIVATE_UPSTREAMS=false
PLUGINPOCKET_STDIO_COMMANDS={}

# CLI / desktop overrides (not read by Go, not automatically exported to desktop apps).
# Uncomment only when deliberately selecting a separate local credential file.
# PLUGINPOCKET_CONFIG=/absolute/path/to/pluginpocket/config.json
# PLUGINPOCKET_TOKEN=ppt_REPLACE_ONLY_FOR_CODEX_DIRECT_MODE
# Harness-internal variables (normally supplied by make test-e2e; see docs/ENVIRONMENT.md):
# PLUGINPOCKET_SERVER_BINARY=/absolute/path/to/build/pluginpocket-server
# PLUGINPOCKET_CLI_BINARY=/absolute/path/to/cli/target/release/pluginpocket
# PLUGINPOCKET_DESKTOP_BINARY=/absolute/path/to/desktop/target/release/pluginpocket-desktop
# PLUGINPOCKET_DESKTOP_TEST_BIN=/absolute/path/to/extracted/pluginpocket-desktop
# PLUGINPOCKET_WEB_E2E=1
# PLUGINPOCKET_E2E_ORIGIN=http://127.0.0.1:TEST_PORT
# PLUGINPOCKET_E2E_ADMIN_USERNAME=operator
# PLUGINPOCKET_E2E_ADMIN_PASSWORD=TEST_ONLY
# 桌面发行仅使用 GitHub Actions Secrets 或构建进程环境，不在应用部署中设置。
# TAURI_SIGNING_PRIVATE_KEY: 独立 PluginPocket 私钥（本地可指定仓库外文件路径）
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD: 可选私钥密码

# Shared file storage: small files use PostgreSQL bytea, larger files require S3.
# See docs/FILE_STORAGE.md for AWS/R2/MinIO/OSS/Spaces/B2 examples.
PLUGINPOCKET_FILE_STORAGE_INLINE_MAX_BYTES=262144
PLUGINPOCKET_FILE_STORAGE_ENDPOINT=
PLUGINPOCKET_FILE_STORAGE_REGION=
PLUGINPOCKET_FILE_STORAGE_BUCKET=
PLUGINPOCKET_FILE_STORAGE_ACCESS_KEY_ID=
PLUGINPOCKET_FILE_STORAGE_SECRET_ACCESS_KEY=
PLUGINPOCKET_FILE_STORAGE_SESSION_TOKEN=
PLUGINPOCKET_FILE_STORAGE_PREFIX=
PLUGINPOCKET_FILE_STORAGE_PATH_STYLE=false
PLUGINPOCKET_FILE_STORAGE_ALLOW_HTTP=false