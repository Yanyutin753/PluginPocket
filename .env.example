# Complete variable reference: docs/ENVIRONMENT.md
# Kubernetes runtime-only template: deploy/kubernetes/runtime.env.example
# This file is for local source / local Compose; never reuse test credentials in production.
# Root Make development commands and pnpm dev load .env automatically.
# Standalone Go and make check still need explicitly exported variables.
LOADOUT_ADDR=127.0.0.1:8787
LOADOUT_WEB_DIR=web/dist
# Optional Vite overrides when using a different local port.
LOADOUT_DEV_PORT=5173
LOADOUT_API_ORIGIN=http://127.0.0.1:8787
# Background Make commands only: use the same directory for up/down/status/logs.
LOADOUT_RUN_DIR=.loadout
# Compose reads .env automatically; this controls the published host port.
LOADOUT_PORT=8787

# Product mode: PostgreSQL is required for accounts, wallet, tools and teams.
# Generate a URL-safe password with: openssl rand -hex 24
LOADOUT_DB_PASSWORD=
LOADOUT_DB_PORT=5432
LOADOUT_DATABASE_URL=postgres://loadout:REPLACE_PASSWORD@127.0.0.1:5432/loadout?sslmode=disable
# Optional shared metadata cache; Redis outages fall back to upstream discovery.
# Use the same namespace for replicas of one deployment; different deployments need distinct namespaces.
LOADOUT_REDIS_URL=redis://127.0.0.1:6379/0
LOADOUT_REDIS_NAMESPACE=loadout
LOADOUT_REDIS_PORT=6379
# Tests use random namespaces and never FLUSHDB.
LOADOUT_TEST_REDIS_URL=redis://127.0.0.1:6379/0
LOADOUT_PUBLIC_URL=http://127.0.0.1:5173
# Generate once with: openssl rand -base64 32. Keep it to decrypt saved upstream credentials.
LOADOUT_ENCRYPTION_KEY=
LOADOUT_INITIAL_CREDITS=1000
# Bootstrap creates this admin only when absent; never resets an existing account.
LOADOUT_ADMIN_USERNAME=
LOADOUT_ADMIN_PASSWORD=
# Dedicated test database, schema-isolated tests; do not point at production.
LOADOUT_TEST_DATABASE_URL=postgres://loadout:REPLACE_PASSWORD@127.0.0.1:5432/loadout_test?sslmode=disable
# Optional integrations: remain explicitly unavailable until configured.
LOADOUT_RATE_TOKEN_PER_MINUTE=
LOADOUT_RATE_USER_PER_DAY=
LOADOUT_GITHUB_API=
LOADOUT_GITHUB_TOKEN=
LOADOUT_GITHUB_CLIENT_ID=
LOADOUT_GITHUB_CLIENT_SECRET=
LOADOUT_GITHUB_ORG=
LOADOUT_SMTP_ADDRESS=
LOADOUT_SMTP_FROM=
LOADOUT_SMTP_USERNAME=
LOADOUT_SMTP_PASSWORD=
LOADOUT_SMTP_ALLOW_LOCAL_INSECURE=false
# Deployment-controlled upstream exceptions. Default HTTPS/public networks only.
LOADOUT_ALLOW_PRIVATE_UPSTREAMS=false
LOADOUT_STDIO_COMMANDS={}

# CLI / desktop overrides (not read by Go, not automatically exported to desktop apps).
# Uncomment only when deliberately selecting a separate local credential file.
# LOADOUT_CONFIG=/absolute/path/to/loadout/config.json
# LOADOUT_TOKEN=ldt_REPLACE_ONLY_FOR_CODEX_DIRECT_MODE
# Harness-internal variables (normally supplied by make test-e2e; see docs/ENVIRONMENT.md):
# LOADOUT_SERVER_BINARY=/absolute/path/to/build/loadout-server
# LOADOUT_CLI_BINARY=/absolute/path/to/cli/target/release/loadout
# LOADOUT_DESKTOP_BINARY=/absolute/path/to/desktop/target/release/loadout-desktop
# LOADOUT_DESKTOP_TEST_BIN=/absolute/path/to/extracted/loadout-desktop
# LOADOUT_WEB_E2E=1
# LOADOUT_E2E_ORIGIN=http://127.0.0.1:TEST_PORT
# LOADOUT_E2E_ADMIN_USERNAME=operator
# LOADOUT_E2E_ADMIN_PASSWORD=TEST_ONLY
# 桌面发行仅使用 GitHub Actions Secrets 或构建进程环境，不在应用部署中设置。
# TAURI_SIGNING_PRIVATE_KEY: 独立 Loadout 私钥（本地可指定仓库外文件路径）
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD: 可选私钥密码
