# Runbook: docs/CLUSTER.md; variable contract: docs/ENVIRONMENT.md
# Copy to .pluginpocket/cluster/runtime.env (ignored by Git); chmod 600; fill placeholders.
# All 20 variables read by the Go server. No test/CLI/Compose variables.
# kubectl --from-env-file reads literal values: do NOT use shell quotes or $VAR expansion.
PLUGINPOCKET_ADDR=0.0.0.0:8787
PLUGINPOCKET_WEB_DIR=/app/web/dist
PLUGINPOCKET_PUBLIC_URL=https://pluginpocket.example.com
PLUGINPOCKET_DATABASE_URL=postgres://pluginpocket:REPLACE_PASSWORD@postgres-primary.example.com:5432/pluginpocket?sslmode=verify-full
PLUGINPOCKET_REDIS_URL=rediss://pluginpocket:REPLACE_PASSWORD@redis-primary.example.com:6379/0
PLUGINPOCKET_REDIS_NAMESPACE=pluginpocket_prod
# Generate once: openssl rand -base64 32. Same key on every replica; preserve during upgrades.
PLUGINPOCKET_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Zero disables signup gifts for newly created users only.
PLUGINPOCKET_INITIAL_CREDITS=0
# Optional first administrator bootstrap: set BOTH, then remove BOTH after bootstrap.
PLUGINPOCKET_ADMIN_USERNAME=
PLUGINPOCKET_ADMIN_PASSWORD=
PLUGINPOCKET_ALLOW_PRIVATE_UPSTREAMS=false
PLUGINPOCKET_STDIO_COMMANDS={}
# Optional GitHub login; callback: PUBLIC_URL/api/v1/auth/github/callback.
PLUGINPOCKET_GITHUB_CLIENT_ID=
PLUGINPOCKET_GITHUB_CLIENT_SECRET=
PLUGINPOCKET_GITHUB_ORG=
# Optional email verification: STARTTLS server, usually port 587 (not implicit TLS/465).
PLUGINPOCKET_SMTP_ADDRESS=
PLUGINPOCKET_SMTP_FROM=
PLUGINPOCKET_SMTP_USERNAME=
PLUGINPOCKET_SMTP_PASSWORD=
PLUGINPOCKET_SMTP_ALLOW_LOCAL_INSECURE=false

# Shared file storage: small files use PostgreSQL bytea, larger files require S3.
# See docs/FILE_STORAGE.md for AWS/R2/MinIO/OSS/Spaces/B2 examples.
PLUGINPOCKET_FILE_STORAGE_INLINE_MAX_BYTES=262144
PLUGINPOCKET_FILE_STORAGE_ENDPOINT=
PLUGINPOCKET_FILE_STORAGE_REGION=
PLUGINPOCKET_FILE_STORAGE_BUCKET=
PLUGINPOCKET_FILE_STORAGE_ACCESS_KEY_ID=
PLUGINPOCKET_FILE_STORAGE_SECRET_ACCESS_KEY=
PLUGINPOCKET_FILE_STORAGE_SESSION_TOKEN=
PLUGINPOCKET_FILE_STORAGE_PREFIX=
PLUGINPOCKET_FILE_STORAGE_PATH_STYLE=false
PLUGINPOCKET_FILE_STORAGE_ALLOW_HTTP=false