# Runbook: docs/CLUSTER.md; variable contract: docs/ENVIRONMENT.md
# Copy to .loadout/cluster/runtime.env (ignored by Git); chmod 600; fill placeholders.
# All 20 variables read by the Go server. No test/CLI/Compose variables.
# kubectl --from-env-file reads literal values: do NOT use shell quotes or $VAR expansion.
LOADOUT_ADDR=0.0.0.0:8787
LOADOUT_WEB_DIR=/app/web/dist
LOADOUT_PUBLIC_URL=https://loadout.example.com
LOADOUT_DATABASE_URL=postgres://loadout:REPLACE_PASSWORD@postgres-primary.example.com:5432/loadout?sslmode=verify-full
LOADOUT_REDIS_URL=rediss://loadout:REPLACE_PASSWORD@redis-primary.example.com:6379/0
LOADOUT_REDIS_NAMESPACE=loadout_prod
# Generate once: openssl rand -base64 32. Same key on every replica; preserve during upgrades.
LOADOUT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Zero disables signup gifts for newly created users only.
LOADOUT_INITIAL_CREDITS=0
# Optional first administrator bootstrap: set BOTH, then remove BOTH after bootstrap.
LOADOUT_ADMIN_USERNAME=
LOADOUT_ADMIN_PASSWORD=
LOADOUT_ALLOW_PRIVATE_UPSTREAMS=false
LOADOUT_STDIO_COMMANDS={}
# Optional GitHub login; callback: PUBLIC_URL/api/v1/auth/github/callback.
LOADOUT_GITHUB_CLIENT_ID=
LOADOUT_GITHUB_CLIENT_SECRET=
LOADOUT_GITHUB_ORG=
# Optional email verification: STARTTLS server, usually port 587 (not implicit TLS/465).
LOADOUT_SMTP_ADDRESS=
LOADOUT_SMTP_FROM=
LOADOUT_SMTP_USERNAME=
LOADOUT_SMTP_PASSWORD=
LOADOUT_SMTP_ALLOW_LOCAL_INSECURE=false

# Shared file storage: small files use PostgreSQL bytea, larger files require S3.
# See docs/FILE_STORAGE.md for AWS/R2/MinIO/OSS/Spaces/B2 examples.
LOADOUT_FILE_STORAGE_INLINE_MAX_BYTES=262144
LOADOUT_FILE_STORAGE_ENDPOINT=
LOADOUT_FILE_STORAGE_REGION=
LOADOUT_FILE_STORAGE_BUCKET=
LOADOUT_FILE_STORAGE_ACCESS_KEY_ID=
LOADOUT_FILE_STORAGE_SECRET_ACCESS_KEY=
LOADOUT_FILE_STORAGE_SESSION_TOKEN=
LOADOUT_FILE_STORAGE_PREFIX=
LOADOUT_FILE_STORAGE_PATH_STYLE=false
LOADOUT_FILE_STORAGE_ALLOW_HTTP=false