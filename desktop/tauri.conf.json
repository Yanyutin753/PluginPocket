{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loadout",
  "version": "0.1.0",
  "identifier": "com.loadout.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loadout \u672c\u5730\u63a5\u5165",
        "width": 960,
        "height": 740,
        "minWidth": 360,
        "minHeight": 540,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Loadout \u672c\u5730 MCP \u63a5\u5165\u5de5\u5177",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png"]
  }
}
