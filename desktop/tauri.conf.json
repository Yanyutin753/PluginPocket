{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loadout",
  "version": "0.1.0",
  "identifier": "com.loadout.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loadout 本地接入",
        "width": 960,
        "height": 740,
        "minWidth": 360,
        "minHeight": 540,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Loadout 本地 MCP 接入工具",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
