{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PluginPocket",
  "version": "0.3.0",
  "identifier": "com.pluginpocket.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PluginPocket · 装备管理台",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 540,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "PluginPocket 本地 AI 装备管理台",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Yanyutin753/PluginPocket/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwOUZENEFGRUI4RTc0OUQKUldTZGRJN3JyOVNmNEhBWDZzVXdxelFmSHQ5dXMvcnZoZVJxYkNwZFl1clNNSThHaDdKSnlzTEQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
